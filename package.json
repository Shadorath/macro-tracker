{
  "name": "macro-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:test": "npm run build && copy scripts\\preview-stubs.js dist\\preview-stubs.js",
    "preview": "vite preview --host",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "ship": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
